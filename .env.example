# ------------------------------------------------------------------
# AssetLotse – your own settings
# Copy once:  cp .env.example .env   and adjust it there.
# .env is NOT part of the update package and is kept on every
# update. Everything is optional – without an entry the default applies.
# ------------------------------------------------------------------

# Publish only on this address (default: all). 127.0.0.1 if the reverse proxy runs directly on
# this machine (not as a container) – then nobody can bypass the proxy. If the proxy
# (e.g. Nginx Proxy Manager) runs as a container: better use a shared Docker network, see README.
#ASSETLOTSE_BIND=127.0.0.1

# Port (default 9343). Applies outside on the server AND inside the container – change it only here,
# not in docker-compose.yml. Allowed: 1024–65535. Afterwards: docker compose up -d
#ASSETLOTSE_PORT=9343

# Time zone (for the reminder time and timestamps). If it is missing in the image, the log
# reports it at start-up and times are in UTC.
#TZ=Europe/Berlin

# Key for sessions AND for encrypting 2FA secrets, stored SMTP/AD passwords and the
# confidential details of items (e.g. BitLocker keys). Without an entry it is generated once and
# stored in ./data/secret_key (recommended). If you set it yourself: at least 32 random characters,
# e.g. python3 -c 'import secrets; print(secrets.token_hex(32))'.
# Do NOT change it later: with a different key 2FA sign-ins fail, passwords and confidential
# details become unreadable – AssetLotse then refuses to start. Only restore the database
# together with its secret_key.
#ASSETLOTSE_SECRET_KEY=
# Only once, to deliberately accept a changed key
# (afterwards reset 2FA, re-enter the SMTP/AD password and the confidential details):
#ASSETLOTSE_ACCEPT_NEW_KEY=1

# User/group the app runs as and that owns ./data (not 0)
#PUID=1000
#PGID=1000

# Reverse proxy: detected automatically. By default proxy headers are only accepted
# from private networks (10.x, 172.16-31.x, 192.168.x, 127.x).
# Only change this if the proxy has a public IP or you want to narrow it down:
#ASSETLOTSE_TRUSTED_PROXIES=private
#ASSETLOTSE_TRUSTED_PROXIES=172.18.0.0/16,192.168.0.11
#ASSETLOTSE_TRUSTED_PROXIES=none

# Secure cookies: "auto" = automatically with HTTPS (default), "1" = always, "0" = never
#ASSETLOTSE_SECURE_COOKIES=auto

# Another database instead of SQLite
#DATABASE_URL=mysql+pymysql://assetlotse:secret@db/assetlotse?charset=utf8mb4

# Log level: INFO (default) or DEBUG
#ASSETLOTSE_LOGLEVEL=INFO

# Folder for the automatic backups (default: ./data/backups).
# For a NAS: mount the drive in docker-compose.override.yml, e.g. /mnt/nas/assetlotse:/backup
#ASSETLOTSE_BACKUP_DIR=/backup

# Link to the source code on the "About" page (e.g. your GitHub repository)
#ASSETLOTSE_SOURCE_URL=https://github.com/YOUR-NAME/assetlotse
